#!/usr/bin/env python3
"""iris-doctor — vérifie qu'Iris est correctement installée et dit quoi réparer.

    iris-doctor [--prefix DIR]

DIR est le dossier de ton shell Quickshell (défaut : celui qui contient ce
script, sinon ~/.config/quickshell). Ne modifie rien (seul un GET /models part vers
les agents `openai` déclarés) et n'envoie aucun message à Claude. Code de sortie 1 s'il y a au moins une erreur (✗).
"""
import contextlib
import http.client
import importlib.util
import io
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import urllib.parse

HOME = os.path.expanduser("~")
DATA = os.path.join(HOME, ".local/share/qs-assistant")
XDG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")

FILES = ["overlays/AssistantOverlay.qml", "overlays/AssistantAvatar.qml", "overlays/AssistantTabs.qml",
         "scripts/assistant.py", "scripts/assistant-prompt.md",
         "scripts/iris-watch.py", "scripts/organize.py", "scripts/iris-ask",
         "scripts/i18n.py", "scripts/assistant-prompt.en.md", "scripts/iris-update", "scripts/iris-remind"]
THEME_TOKENS = ["bg", "fg", "ff", "fs", "primary", "secondary", "tertiary",
                "lavender", "light", "outline", "txt2", "error", "warn"]

counts = {"ok": 0, "warn": 0, "fail": 0}
tty = sys.stdout.isatty()


def color(code, s):
    return f"\033[{code}m{s}\033[0m" if tty else s


def report(level, msg, hint=""):
    counts[level] += 1
    mark = {"ok": color(32, "✓"), "warn": color(33, "!"), "fail": color(31, "✗")}[level]
    print(f"  {mark} {msg}")
    if hint and level != "ok":
        print(f"      → {hint}")


def section(title):
    print("\n" + color("1;35", f"▸ {title}"))


def read(path):
    try:
        with open(path, errors="replace") as f:
            return f.read()
    except OSError:
        return None


def run(cmd, timeout=8):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def default_prefix():
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if os.path.isdir(os.path.join(here, "overlays")) and os.path.isfile(os.path.join(here, "shell.qml")):
        return here
    return os.path.join(XDG, "quickshell")


def configured_agent():
    """(name, spec) of the agent set in config.json; ("claude", None) by default."""
    try:
        cfg = json.load(open(os.path.join(DATA, "config.json")))
        try:                                   # the panel's picker wins over config.json
            picked = open(os.path.join(DATA, "agent")).read().strip()
            if picked == "claude" or picked in cfg["agents"]:
                cfg["agent"] = picked
        except OSError:
            pass
        name, spec = cfg["agent"], cfg["agents"][cfg["agent"]]
        if name != "claude" and (spec.get("type") == "openai"
                                 or isinstance(spec.get("command"), list) and spec["command"]):
            return name, spec
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass
    return "claude", None


def served_models(mod, spec):
    """(status, model ids) from GET {base_url}/models; (None, reason) if unreachable. Follows no redirect."""
    u = urllib.parse.urlsplit(spec["base_url"])
    headers = {"Authorization": "Bearer " + mod.read_key(spec["key_file"])} if spec.get("key_file") else {}
    cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
    conn = cls(u.hostname, u.port, timeout=3)
    try:
        conn.request("GET", u.path.rstrip("/") + "/models", headers=headers)
        resp = conn.getresponse()
        body = resp.read(1_000_000)
        try:
            ids = {m["id"] for m in json.loads(body)["data"]}
        except (ValueError, KeyError, TypeError):
            ids = set()
        return resp.status, ids
    except (OSError, http.client.HTTPException):
        return None, f"{u.netloc} ne répond pas"
    finally:
        conn.close()


def check_openai_agent(mod, name, spec):
    url = spec.get("base_url")
    if not (isinstance(url, str) and mod.endpoint_ok(url)):
        report("warn", f"« {name} » : adresse refusée", "https://, ou http:// vers localhost seulement (`base_url`)")
        return
    if spec.get("key_file"):
        try:
            mod.read_key(spec["key_file"])
        except ValueError as e:
            report("warn", f"« {name} » : {e}", "chmod 600 sur le fichier, ou corrige `key_file`")
            return
    status, ids = served_models(mod, spec)
    if status is None:
        report("warn", f"« {name} » : {ids}", "lance le serveur (ex. `ollama serve`) ou corrige `base_url`")
    elif status in (401, 403):
        report("warn", f"« {name} » : clé refusée ({status})", "vérifie le contenu de `key_file`")
    elif status != 200:
        report("warn", f"« {name} » : le serveur répond {status}", "vérifie `base_url` (il se termine souvent par /v1)")
    else:
        report("ok", f"« {name} » : {url} répond")
        models = spec.get("models") if isinstance(spec.get("models"), dict) else {}
        for m in sorted({v for v in models.values() if isinstance(v, str) and v}) if ids else []:
            if m in ids or f"{m}:latest" in ids:
                report("ok", f"  modèle {m} disponible")
            else:
                report("warn", f"  modèle {m} absent du serveur", "corrige `models` ou télécharge-le")
    if not mod.is_local(url):
        mem = "envoyée" if spec.get("send_memory") is True else "non envoyée"
        report("ok", f"  hôte distant : memory.md {mem} (`send_memory`)")


def check_agents(prefix):
    """Every agent declared in config.json: program present, Ollama models downloaded, API reachable."""
    try:
        agents = json.load(open(os.path.join(DATA, "config.json"))).get("agents") or {}
    except (OSError, ValueError, AttributeError):
        return
    if not isinstance(agents, dict) or not agents:
        return
    section("Agents déclarés")
    have = None
    mod, _ = load_module(prefix)
    for name, spec in agents.items():
        if isinstance(spec, dict) and spec.get("type") == "openai":
            if mod is None:
                report("warn", f"« {name} » : assistant.py illisible, vérification impossible")
            else:
                check_openai_agent(mod, name, spec)
            continue
        cmd = spec.get("command") if isinstance(spec, dict) else None
        if not (isinstance(cmd, list) and cmd and all(isinstance(x, str) for x in cmd)):
            report("warn", f"« {name} » : commande invalide", "corrige `command` dans config.json")
        elif not shutil.which(os.path.expanduser(cmd[0])):
            report("warn", f"« {name} » : {cmd[0]} introuvable", "installe-le avant de choisir cet agent dans le panneau")
        else:
            report("ok", f"« {name} » : {cmd[0]}")
        if cmd and cmd[:2] == ["ollama", "run"] and shutil.which("ollama"):
            if have is None:
                code, out = run(["ollama", "list"])
                have = {ln.split()[0] for ln in out.splitlines()[1:] if ln.split()} if code == 0 else False
            if have is False:
                report("warn", "ollama ne répond pas", "lance le service (`ollama serve`)")
                continue
            models = spec.get("models") if isinstance(spec.get("models"), dict) else {}
            for m in sorted({v for v in models.values() if isinstance(v, str) and v}):
                if m in have or f"{m}:latest" in have:
                    report("ok", f"  modèle {m} téléchargé")
                else:
                    report("warn", f"  modèle {m} absent", f"ollama pull {m}")


def check_requirements():
    section("Prérequis")
    agent, spec = configured_agent()
    v = sys.version_info
    if v >= (3, 9):
        report("ok", f"python {v.major}.{v.minor}")
    else:
        report("fail", f"python {v.major}.{v.minor} trop ancien", "Iris demande Python 3.9 ou plus")
    for cmd, why, level in [("claude", "CLI Claude Code : https://claude.com/claude-code",
                             "fail" if spec is None else "warn"),
                            ("qs", "Quickshell : https://quickshell.org", "fail"),
                            ("git", "nécessaire aux alertes git", "warn"),
                            ("wl-paste", "paquet wl-clipboard (raccourci iris-ask)", "warn"),
                            ("notify-send", "paquet libnotify (notifications d'alerte)", "warn"),
                            ("gio", "paquet glib2 (corbeille du rangement)", "warn"),
                            ("nautilus", "ouverture des fichiers cités par Iris (sinon xdg-open)", "warn")]:
        if shutil.which(cmd):
            extra = ""
            if cmd == "claude":
                code, out = run(["claude", "--version"])
                extra = f" ({out.splitlines()[0]})" if code == 0 and out else ""
            report("ok", cmd + extra)
        else:
            report(level, f"{cmd} introuvable", why)
    if spec is not None:
        exe = str(spec["command"][0]) if "command" in spec else ""
        if not exe:
            report("ok", f"agent « {agent} » : API {spec.get('base_url', '?')}")
        elif shutil.which(os.path.expanduser(exe)):
            report("ok", f"agent « {agent} » : {exe}")
        else:
            report("fail", f"agent « {agent} » : {exe} introuvable",
                   "installe-le, ou remets `agent` à \"claude\" dans config.json")
        report("warn", f"agent « {agent} » : hors cartes Autoriser / Refuser",
               "Iris ne contrôle pas les outils propres à cet agent (voir le README)")
    elif shutil.which("claude"):
        creds = os.path.join(HOME, ".claude/.credentials.json")
        cfg = read(os.path.join(HOME, ".claude.json")) or ""
        if os.path.exists(creds) or '"oauthAccount"' in cfg:
            report("ok", "claude semble connecté à un compte")
        else:
            report("warn", "claude ne semble pas connecté", "lance `claude` une fois dans un terminal pour te connecter")


def check_files(prefix):
    section(f"Fichiers dans {prefix}")
    if not os.path.isdir(prefix):
        report("fail", "dossier Quickshell introuvable", "relance ./install.sh (ou --prefix DIR)")
        return False
    missing = [f for f in FILES if not os.path.isfile(os.path.join(prefix, f))]
    if missing:
        for f in missing:
            report("fail", f"manquant : {f}", "relance ./install.sh")
    else:
        report("ok", f"{len(FILES)} fichiers présents")
    for f in ("scripts/assistant.py", "scripts/iris-watch.py", "scripts/iris-ask", "scripts/iris-update"):
        p = os.path.join(prefix, f)
        if os.path.isfile(p) and not os.access(p, os.X_OK):
            report("warn", f"{f} n'est pas exécutable", f"chmod +x {p}")
    for f in ("scripts/assistant.py", "scripts/iris-watch.py", "scripts/organize.py", "scripts/i18n.py"):
        p = os.path.join(prefix, f)
        if os.path.isfile(p):
            code, out = run([sys.executable, "-I", "-m", "py_compile", p])
            if code:
                report("fail", f"{f} ne compile pas", out.splitlines()[-1] if out else "")
    return not missing


def check_wiring(prefix):
    section("Câblage de shell.qml")
    path = os.path.join(prefix, "shell.qml")
    s = read(path)
    if s is None:
        report("fail", "shell.qml introuvable", "voir integration/shell.qml.snippet")
        return
    checks = [
        (r"\bAssistantOverlay\s*\{", "l'overlay est instancié", "ajoute  AssistantOverlay { id: assistantOverlay; shellRoot: root; theme: theme }"),
        (r'^\s*import\s+"\./?overlays/?"', 'import "./overlays"', 'ajoute  import "./overlays"  en haut de shell.qml'),
        (r"^\s*import\s+Quickshell\.Io\b", "import Quickshell.Io", "ajoute  import Quickshell.Io  (IpcHandler)"),
        (r'target:\s*"assistant"', "cible IPC « assistant »", "voir integration/shell.qml.snippet"),
        (r"function prefill\(", "fonction IPC prefill (raccourci « joindre la sélection »)", "relance ./install.sh : il l'ajoute"),
        (r"\bassistantOpen\b", "propriété assistantOpen", "voir integration/shell.qml.snippet"),
        (r"\bassistantMood\b", "propriété assistantMood", "voir integration/shell.qml.snippet"),
        (r"\bassistantUnread\b", "propriété assistantUnread", "voir integration/shell.qml.snippet"),
        (r"\bconfigDir\b", "propriété configDir", "property string configDir: Quickshell.shellDir"),
        (r"\bhomeDir\b", "propriété homeDir", 'property string homeDir: Quickshell.env("HOME")'),
        (r"\bid:\s*theme\b", "objet theme", "l'overlay a besoin d'un objet  id: theme  (voir AGENTS.md)"),
    ]
    for rx, label, hint in checks:
        if re.search(rx, s, re.M):
            report("ok", label)
        else:
            report("fail", f"{label} : absent", hint)
    # Theme tokens: look for their definition anywhere in the shell's QML.
    qml = s
    for root, _, files in os.walk(prefix):
        for f in files:
            if f.endswith(".qml") and not f.startswith("Assistant"):
                qml += read(os.path.join(root, f)) or ""
    absent = [t for t in THEME_TOKENS
              if not re.search(r"\b(property\s+\w+\s+|readonly property\s+\w+\s+)?%s\s*:" % re.escape(t), qml)]
    if absent:
        report("warn", "champs de thème introuvables : " + ", ".join(absent),
               "vérification approximative ; si l'overlay s'affiche mal, voir « Contrat avec le shell hôte » dans AGENTS.md")
    else:
        report("ok", "champs de thème trouvés")


def load_module(prefix):
    path = os.path.join(prefix, "scripts/assistant.py")
    if not os.path.isfile(path):
        return None, ""
    spec = importlib.util.spec_from_file_location("iris_assistant_check", path)
    mod = importlib.util.module_from_spec(spec)
    err = io.StringIO()
    old_home = os.environ.get("HOME")
    try:
        with contextlib.redirect_stderr(err):
            spec.loader.exec_module(mod)
    except Exception as e:      # noqa: BLE001 — report, don't crash
        return None, f"{type(e).__name__}: {e}"
    finally:
        if old_home is not None:
            os.environ["HOME"] = old_home
    return mod, err.getvalue()


def check_data(prefix):
    section(f"Données dans {DATA}")
    if not os.path.isdir(DATA):
        report("warn", "dossier absent", "il sera créé au premier lancement d'Iris, ou relance ./install.sh")
        return
    mode = stat.S_IMODE(os.stat(DATA).st_mode)
    if mode & 0o077:
        report("warn", f"dossier en {mode:o} : lisible par d'autres comptes", f"chmod 700 {DATA}")
    else:
        report("ok", "dossier en 700")
    mem = os.path.join(DATA, "memory.md")
    report("ok", "memory.md présent") if os.path.isfile(mem) else report(
        "warn", "memory.md absent", "copie integration/memory.example.md (ou relance ./install.sh)")
    for name in ("watch.json", "config.json"):
        p = os.path.join(DATA, name)
        if not os.path.isfile(p):
            report("warn", f"{name} absent", "relance ./install.sh (valeurs par défaut sinon)")
            continue
        try:
            json.load(open(p))
            report("ok", f"{name} valide")
        except ValueError as e:
            report("fail", f"{name} : JSON invalide", str(e))
    mod, err = load_module(prefix)
    if mod is None:
        if err:
            report("fail", "assistant.py ne se charge pas", err)
        return
    problems = [ln for ln in err.splitlines() if ln.startswith("[iris]")]
    if problems:
        for ln in problems:
            report("warn", ln.replace("[iris] ", ""), "corrige config.json (la valeur par défaut est utilisée)")
    else:
        report("ok", "config.json : toutes les valeurs sont acceptées")
    cfg = getattr(mod, "CONFIG", {})
    pf = getattr(mod, "PROMPT_FILE", "")
    if not os.path.isfile(pf):
        report("fail", f"fichier de prompt introuvable : {pf}", "vérifie `prompt_file` dans config.json")
    for p in cfg.get("deny_read_paths", []):
        if not os.path.exists(os.path.expanduser(p)):
            report("warn", f"deny_read_paths : {p} n'existe pas", "sans gravité, mais vérifie l'orthographe")


def check_skills():
    section("Skills (recettes perso)")
    d = os.path.join(DATA, "skills")
    if not os.path.isdir(d):
        print("  · aucun dossier de skills (facultatif) : crée-en dans " + d)
        return
    files = sorted(f for f in os.listdir(d) if f.endswith(".md"))
    bad = [f for f in files if not re.fullmatch(r"[\w.-]+", f[:-3]) or f.startswith(".")]
    report("ok", f"{len(files) - len(bad)} recette(s) : " + ", ".join(f[:-3] for f in files if f not in bad)) if files else report(
        "warn", "dossier vide", "ajoute un fichier nom.md (description: dans l'en-tête) ; voir README")
    for f in bad:
        report("warn", f"{f} ignoré", "nom sans espace ni caractère spécial, extension .md")


def check_updates():
    section("Mises à jour")
    src = (read(os.path.join(DATA, "source")) or "").strip()
    if not src:
        report("warn", "emplacement du clone inconnu", "relance ./install.sh depuis ton clone : iris-update en a besoin")
        return
    if not os.path.isdir(os.path.join(src, ".git")):
        report("fail", f"{src} n'est plus un clone git", "re-clone le repo, puis relance ./install.sh dedans")
        return
    report("ok", f"clone : {src}")
    code, rev = run(["git", "-C", src, "rev-parse", "--short", "HEAD"])
    inst = (read(os.path.join(DATA, "installed-rev")) or "").strip()[:7]
    if code == 0 and inst and rev and not rev.startswith(inst):
        report("warn", f"installée : {inst}, clone : {rev}", "lance iris-update (ou ./install.sh) pour installer la version du clone")
    elif code == 0:
        report("ok", f"version installée : {rev}")
    if os.path.isfile(os.path.join(os.path.dirname(os.path.abspath(__file__)), "iris-update")):
        report("ok", "iris-update disponible")


def check_hyprland():
    section("Hyprland (facultatif)")
    hypr = os.path.join(XDG, "hypr")
    if not os.path.isdir(hypr):
        print("  · pas de config Hyprland trouvée : étape ignorée")
        return
    blob = ""
    for root, _, files in os.walk(hypr):
        for f in files:
            if f.endswith((".lua", ".conf")):
                blob += read(os.path.join(root, f)) or ""
    report("ok", "règle de flou du panneau") if "quickshell-assistant" in blob else report(
        "warn", "pas de règle de flou pour le panneau", "voir integration/hyprland-layer-rule.lua (cosmétique)")
    report("ok", "raccourci iris-ask") if "iris-ask" in blob else report(
        "warn", "pas de raccourci iris-ask", "relance ./install.sh ou ajoute un bind vers scripts/iris-ask")
    report("ok", "raccourci iris-ask --edit") if "iris-ask --edit" in blob else report(
        "warn", "pas de raccourci « joindre la sélection »", "relance ./install.sh (ou ajoute un bind vers scripts/iris-ask --edit)")


def check_runtime():
    section("Quickshell en cours d'exécution")
    if not shutil.which("qs"):
        return
    code, out = run(["qs", "ipc", "show"])
    if code == 0 and "assistant" in out:
        report("ok", "la cible IPC « assistant » répond (Iris est chargée)")
    elif code == 0:
        report("warn", "Quickshell tourne mais Iris n'est pas chargée", "recharge Quickshell après l'installation")
    else:
        report("warn", "aucune instance Quickshell détectée", "lance ton shell, puis relance le diagnostic")


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    prefix = default_prefix()
    if args[:1] == ["--prefix"] and len(args) > 1:
        prefix = os.path.expanduser(args[1])
    print(color("1", "Diagnostic d'Iris"))
    check_requirements()
    check_agents(prefix)
    if check_files(prefix):
        check_wiring(prefix)
    check_data(prefix)
    check_skills()
    check_updates()
    check_hyprland()
    check_runtime()
    print(f"\n{color('1', 'Bilan')} : {counts['ok']} ok, {counts['warn']} avertissement(s), {counts['fail']} erreur(s)")
    return 1 if counts["fail"] else 0


if __name__ == "__main__":
    sys.exit(main())
